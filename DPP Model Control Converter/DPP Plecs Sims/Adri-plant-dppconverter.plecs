            Value         "#include <math.h>\n"
"#include <stdio.h>\n"
"#define G3 InputSignal(0,0)    //input irradiance param\n"
"#define T3 InputSignal(0,1)\n"
"\n"
"#define Ien3 OutputSignal(0,0)\n"
"\n"
"\n"
"float Isc=9.91;                           //short-circuit current\n"
"\n"
"float Ipho=9.91;\n"
"//float T1;\n"
"//float Tn=298;                             //nominal temperature\n"
"float Ki=0.0006;                   //current coefficient/temperature\n"
"\n"
"//float a=1.2;                             //diode ideality factor\n"
"float a=1;                             //diode ideality factor\n"
"\n"
"long double k=1.38e-23;                      //boltzmann's constant\n"
"long double q=1.602e-19;                     //electron charge\n"
"\n"
"\n"
"\n"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "\n"
"\n"
"//T1=T0+273;\n"
"float Ki=0.0006*Isc; \n"
"Ien3= G3*(Ipho+Ki*(T3-298));\n"
"  \n"
"  \n"
"  \n"
"  \n"
"\n"
            Show          off
          }
          Parameter {
            Variable      "UpdateFcn"
            Value         ""
            Show          off
          }
