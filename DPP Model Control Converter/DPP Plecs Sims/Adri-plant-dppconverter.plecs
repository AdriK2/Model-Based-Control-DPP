"\n"
"//T1=T0+273;\n"
"float Ki=0.0006*Isc;                   //current coefficient/temperature \n"
"  \n"
"Ien1= G1*(Ipho+Ki*(T1-298));\n"
"  \n"
"  \n"
"  \n"
"  \n"
"\n"
