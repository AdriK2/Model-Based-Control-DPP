          Parameter {
            Variable      "Declarations"
            Value         "#include <math.h>\n"
"#include <stdio.h>\n"
"//#define G InputSignal(0,0)    //input irradiance param\n"
"//#define Im1 InputSignal(0,0)\n"
"//#define Vpre InputSignal(0,1)\n"
"#define Isat2 InputSignal(0,0)  //input  \n"
"#define T2 InputSignal(0,1)  //input  \n"
"#define Imea2 InputSignal(0,2)  //input  \n"
"#define Vmea2 InputSignal(0,3)  //input  \n"
"\n"
"#define Idio2 OutputSignal(0,0)\n"
"\n"
"float P, V0 ;\n"
"\n"
"float Isc=9.91;                           //short-circuit current\n"
"float Ipho=9.91;                           //short-circuit current\n"
"float Im=9.39;                            //maximum Current\n"
"\n"
"float Is1;  //saturation current Dpp1\n"
"float dI1;  // derivation of current\n"
"                              //Isc should be less than the max current value"
"\n"
"//float Voc=39.71;                          //open circuit voltage\n"
"float Voc=39.71/3;                          //open circuit voltage\n"
"float Vm=32.5/3;                          //maximum voltage\n"
"float Vm1=32.5/3;                          //maximum voltage Dpp1  input\n"
"\n"
"\n"
"//float T2;\n"
"\n"
"float Tn=298;                             //nominal temperature\n"
"float Ki=0.0006;                   //current coefficient/temperature\n"
"\n"
"float Kv=-0.0028;                  //voltage coefficient/temerature\n"
"float B=-0.0028;                  //voltage coefficient/temerature before it "
"times Voc\n"
"float Gn=1000;                           //nominal irradiance (stc)\n"
"//float a=1.2;                             //diode ideality factor\n"
"float a=1;                             //diode ideality factor\n"
"//int Ns=60;                               //series connected cells\n"
"int Ns=60/3;                               //series connected cells\n"
"//float Eg=1.12;                           //energy band gap\n"
"//float Rs=0.1556;                       //series resistance\n"
"float Rs=0.0907;                       //series resistance\n"
"//float Rp=500;                          //parallel resistance\n"
"float Rp=276.434;                          //parallel resistance\n"
"long double k=1.38e-23;                      //boltzmann's constant\n"
"long double q=1.602e-19;                     //electron charge\n"
"\n"
"\n"
            Show          off
          }
          Parameter {
            Variable      "StartFcn"
            Value         ""
            Show          off
          }
          Parameter {
            Variable      "OutputFcn"
            Value         "\n"
"//V= G*(Ipho+Ki*(T1-298));\n"
"//T1=T0+273;\n"
"//V=(Ipho+Ipho*Rs/Rp-(Voc+B*(T1-298))/Rp)/(exp(q*(Voc+B*(T1-298))/(Ns*k*T1*a)"
")-exp(q*Ipho*Rs/(Ns*k*T1*a)));\n"
"//T2 = T0 + 273;\n"
"Idio2 = Isat2*(exp( (Vmea2+Imea2*Rs)*q/(Ns*a*k*T2) )    -1);\n"
"\n"
"         // u(1)*(exp((u(4)+u(3)*Rs)*q/(Ns*A*K*u(2)))-1)\n"
"\n"
"\n"
"//#define Isat InputSignal(0,0)  //input  \n"
"//#define T1 InputSignal(0,1)  //input  \n"
"//#define Imea InputSignal(0,2)  //input  \n"
"//#define Vmea InputSignal(0,3)  //input  \n"
            Show          off
          }
